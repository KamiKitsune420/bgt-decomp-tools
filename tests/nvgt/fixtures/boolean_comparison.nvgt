// A regression fixture for boolean-comparison simplification. The compiler
// often compares a bool against a literal; the decompiler used to keep it
// (`!(getf(x)) == false`) instead of the value or its negation. `== true` /
// `!= false` is the value, `== false` / `!= true` is its negation, and a double
// negation cancels -- `!(getf(x)) == false` is `getf(x)`.
bool getf(int x) { return x > 3; }

int classify(int x) {
	if (getf(x) == false) return 1;
	if (getf(x) == true) return 2;
	return 3;
}

int also(int x) {
	if (getf(x) != false) return 10;
	if (getf(x) != true) return 20;
	return 30;
}

void main() {
	int total = 0;
	total += classify(1) + classify(9) * 10;        // 1 + 20
	total += also(1) * 100 + also(9) * 10000;       // 20 -> 2000 ; 10 -> 100000
	file_put_contents("result.txt", "" + total);
	file_put_contents("debug.bin", script_get_module("nvgt_game", 0).get_bytecode(false));
	file_put_contents("strip.bin", script_get_module("nvgt_game", 0).get_bytecode(true));
}
